{
  "contract_version": "2026-11-15",
  "tables": [
    "orders",
    "order_items",
    "customers",
    "payments",
    "shipments",
    "products",
    "inventory",
    "refunds"
  ],
  "envelope": {
    "txn_id": {"type": "string", "required": false, "note": "非空即进入事务装配 M8"},
    "part_no": {"type": "int", "required": false, "note": "分片号，从 1 起，需 <= part_total"},
    "part_total": {"type": "int", "required": false, "note": "事务分片总数"}
  },
  "fields": {
    "ref": {
      "type": "string",
      "required": false
    },
    "status": {
      "type": "string",
      "required": true
    },
    "amount": {
      "type": "decimal",
      "required": false,
      "scale": "0.01"
    },
    "qty": {
      "type": "int",
      "required": false
    }
  },
  "aliases": {
    "ref_no": "ref",
    "amt": "amount",
    "st": "status",
    "qt": "qty"
  },
  "schemas": [
    "v1",
    "v2"
  ],
  "window": {
    "late_minutes": 10,
    "snapshot": "event_time <= as_of"
  }
}
